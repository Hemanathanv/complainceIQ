FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY ["#05 temporal/requirements.txt", "/app/requirements.txt"]
COPY ["#02 fact check/gstbot/requirements.txt", "/app/gstbot-requirements.txt"]
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --default-timeout=100 --retries=10 -r /app/requirements.txt
RUN pip install --no-cache-dir --default-timeout=100 --retries=10 torch==2.14.0+cpu --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir --default-timeout=100 --retries=10 -r /app/gstbot-requirements.txt
RUN playwright install --with-deps chromium
COPY ["#05 temporal", "/app/temporal"]
COPY ["#02 fact check/gstbot", "/app/#02 fact check/gstbot"]
CMD ["python", "/app/temporal/workers/gst_worker.py"]

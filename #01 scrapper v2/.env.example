# Base directory for downloaded compliance documents.
# Leave blank to use the scrapper v2 folder.
DOWNLOAD_BASE_PATH=

# Optional per-scraper limits. 0 means process all available items.
SEBI_MAX_ITEMS=0
INCOME_TAX_MAX_ITEMS=0

# Browser mode: false/headless by default; use true for unattended runs.
SEBI_HEADLESS=false
INCOME_TAX_HEADLESS=false
